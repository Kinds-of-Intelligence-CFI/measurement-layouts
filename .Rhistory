} else if (abs(x_val) <= 0.125 && y_val >= 0.75){
reward = min(-log(constant * abs(distance)), top_reward)
} else if (abs(x_val) > 0.125 && y_val >= 0.75){
reward = -5*distance
} else if (abs(x_val) <= 0.25 && y_val < 0.75){
reward = -5
} else if (abs(x_val) > 0.25 && y_val > 0) {
reward = -5*distance
} else {
reward = -5
}
return(reward)
}
